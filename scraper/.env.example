# --- Segurança (mesmo valor de SCRAPER_INTERNAL_TOKEN no Next.js) ---
SCRAPER_INTERNAL_TOKEN=gere-com-openssl-rand-hex-32

# --- Anti-bloqueio ---
SCRAPING_PROVIDER=zenrows            # zenrows | scraperapi
ZENROWS_API_KEY=
SCRAPERAPI_KEY=
SCRAPING_FALLBACK_ENABLED=true       # usa o outro provedor se o primário falhar
SCRAPERAPI_ULTRA_PREMIUM=false
PLAYWRIGHT_FALLBACK=false            # só para portais não protegidos
MAX_CONCURRENCY=6
REQUEST_TIMEOUT_S=90
PORTAL_TIMEOUT_S=100
RETRIES_PER_PROVIDER=1

# --- Cache (Supabase > Project Settings > Database > Connection string, modo "Session" ou "Transaction") ---
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
CACHE_TTL_HOURS=6

LOG_LEVEL=INFO
